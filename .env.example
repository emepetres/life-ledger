# Operator file for the mini-PC runbook (docs/deployment/mini-pc/README.md).
#
# Copy to `.env` (gitignored) on the dev machine and fill it in. No script reads
# it: it is a scratchpad for the values you paste into the box's files. The
# password manager is canonical; this file is a convenience copy.

# --- /etc/life-ledger/app.env (the app; ADR-0004) -----------------------------

# bcrypt hash of the shared login password. Generate with `make hash-password`.
# The plaintext is never stored.
LIFELEDGER_PASSWORD_HASH=""

# Session-cookie signing secret: a long random string (32 random bytes, Base64).
# Rotating it logs everyone out.
LIFELEDGER_SESSION_KEY=""

# --- Dev machine only (reaching the Proxmox host; never copied to the box) ----

MINIPC_HOST="192.168.1.167"
MINIPC_USER="root"
MINIPC_PASSWORD=""
PROXMOX_PORT="8006"

# --- /etc/life-ledger/cloudflared.env (the tunnel; ADR-0013) ------------------
# Written there as TUNNEL_TOKEN=<value>.

CLOUDFLARE_TUNNEL_TOKEN=""

# --- rclone config and /etc/life-ledger/backup.env (nightly backup; ADR-0014) --
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET go into the `gdrive` remote when you
# run `rclone config` (-> /etc/life-ledger/rclone.conf).
# HEALTHCHECK_URL goes into backup.env as HEALTHCHECK_URL=<value>.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
HEALTHCHECK_URL=""
