# First-deploy configuration for scripts/first-deploy.ps1.
#
# Copy this file to `.env` (which is gitignored), fill in the values, then run:
#
#     pwsh scripts/first-deploy.ps1
#
# The script is idempotent: re-running reuses the existing app registration and
# federated credential and converges the repo secrets/variables to this file.
# See docs/deployment/first-deploy.md for the full walkthrough.

# Azure subscription the resource group and all resources live in.
SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"

# Resource group to create/reuse. The deploy identity is scoped here (least
# privilege), and infra.yml reads it from the AZURE_RESOURCE_GROUP variable.
RESOURCE_GROUP="life-ledger-rg"

# Azure region for the resource group and every resource.
LOCATION="westeurope"

# GitHub repository as owner/repo. The OIDC federated credential and the repo
# secrets/variables are set on this repo.
REPO="emepetres/life-ledger"

# Display name of the Entra app registration used for GitHub -> Azure OIDC.
# The script looks this up by name and reuses it, so re-runs never create a
# duplicate identity.
APP_REG_NAME="jcarnero-life-ledger-github"

# --- App secrets (ADR-0004) --------------------------------------------------
#
# Both are required in production. Set a value here to pin your own. Leave a value
# EMPTY and the script generates/collects it (bcrypt-hash a password you type;
# mint a random session key) ONLY on the first run — on a re-run it leaves the
# already-set repo secret untouched, so re-running never rotates your session key
# or re-hashes your password.

# bcrypt hash of the shared login password. Generate with `make hash-password`.
# The plaintext password is never stored. Leave empty to be prompted.
LIFELEDGER_PASSWORD_HASH=""

# Session-cookie signing secret: any long random string. Rotating it logs you
# out everywhere. Leave empty to have the script mint a random 32-byte key.
LIFELEDGER_SESSION_KEY=""
